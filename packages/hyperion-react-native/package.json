{
  "name": "hyperion-react-native",
  "description": "Plugin-based React Native AutoLogging runtime",
  "version": "0.0.1",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "babel-plugin-stable-event-props.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./channel": {
      "types": "./dist/channel.d.ts",
      "default": "./dist/channel.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./surfaces": {
      "types": "./dist/ALSurface.d.ts",
      "default": "./dist/ALSurface.js"
    },
    "./ui-events": {
      "types": "./dist/ALUIEvents.d.ts",
      "default": "./dist/ALUIEvents.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    },
    "./app-lifecycle": {
      "types": "./dist/ALAppLifecycle.d.ts",
      "default": "./dist/ALAppLifecycle.js"
    },
    "./heartbeat": {
      "types": "./dist/ALHeartbeat.d.ts",
      "default": "./dist/ALHeartbeat.js"
    },
    "./app-state-events": {
      "types": "./dist/ALAppStateEvents.d.ts",
      "default": "./dist/ALAppStateEvents.js"
    },
    "./screens": {
      "types": "./dist/ALScreen.d.ts",
      "default": "./dist/ALScreen.js"
    },
    "./list-impressions": {
      "types": "./dist/ALListViewability.d.ts",
      "default": "./dist/ALListViewability.js"
    },
    "./deep-links": {
      "types": "./dist/ALDeepLink.d.ts",
      "default": "./dist/ALDeepLink.js"
    },
    "./react-errors": {
      "types": "./dist/ALReactError.d.ts",
      "default": "./dist/ALReactError.js"
    },
    "./transport": {
      "types": "./dist/ALTransport.d.ts",
      "default": "./dist/ALTransport.js"
    },
    "./legacy-runtime-installer": {
      "types": "./dist/legacy-runtime-installer.d.ts",
      "default": "./dist/legacy-runtime-installer.js"
    },
    "./babel-plugin-stable-event-props": "./babel-plugin-stable-event-props.cjs"
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run clean && tsc",
    "build-go": "npm run clean && tsgo",
    "watch": "npm run build -- --watch",
    "start": "npm run watch",
    "test": "npm run build && jest"
  },
  "workspaces": [
    "../hyperion-autologging",
    "../hyperion-channel",
    "../hyperion-devtools",
    "../hyperion-hook",
    "../hyperion-util"
  ],
  "dependencies": {
    "hyperion-autologging": "*",
    "hyperion-channel": "*",
    "hyperion-hook": "*",
    "hyperion-util": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "hyperion-devtools": "*",
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.24.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.3",
    "@react-native/eslint-config": "0.78.3",
    "@react-native/metro-config": "0.78.3",
    "@react-native/typescript-config": "0.78.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.0.0",
    "react-native": "0.78.3",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  }
