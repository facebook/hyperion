{
  "name": "hyperion-react-native",
  "description": "Utility to intercept React Native api",
  "version": "0.0.1",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "babel-plugin-stable-event-props.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./legacy-runtime-installer": {
      "types": "./dist/legacy-runtime-installer.d.ts",
      "default": "./dist/legacy-runtime-installer.js"
    },
    "./babel-plugin-stable-event-props": "./babel-plugin-stable-event-props.cjs"
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run clean && tsc",
    "build-go": "npm run clean && tsgo",
    "watch": "npm run build -- --watch",
    "start": "npm run watch",
    "test": "npm run build && jest",
    "benchmark:runtime": "HYPERION_RUNTIME_BENCHMARK=1 node --expose-gc ../../node_modules/jest/bin/jest.js --watchman=false --runInBand --coverage=false --runTestsByPath test/RuntimeBenchmark.test.ts"
  },
  "workspaces": [
    "../hyperion-channel",
    "../hyperion-autologging-shared",
    "../hyperion-devtools",
    "../hyperion-util"
  ],
  "dependencies": {
    "hyperion-channel": "*",
    "hyperion-autologging-shared": "*",
    "hyperion-util": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "hyperion-devtools": "*",
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.24.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.3",
    "@react-native/eslint-config": "0.78.3",
    "@react-native/metro-config": "0.78.3",
    "@react-native/typescript-config": "0.78.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.0.0",
    "react-native": "0.78.3",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  }
}
